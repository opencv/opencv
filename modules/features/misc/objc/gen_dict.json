        "FlannBasedMatcher": {
            "FlannBasedMatcher": {
                "declaration" : [
                    "",
                    "//",
                    "// C++:   cv::FlannBasedMatcher::FlannBasedMatcher(Ptr_flann_IndexParams indexParams = makePtr<flann::KDTreeIndexParams>(), Ptr_flann_SearchParams searchParams = makePtr<flann::SearchParams>())",
                    "//",
                    "/**",
                    " * Creates a FLANN-based descriptor matcher with custom index and search parameters.",
                    " *",
                    " * The dictionaries follow the same conventions as the Python bindings. Values may be",
                    " * Bool, Int, Double or String. The key \"algorithm\" selects the index type",
                    " * (e.g. 1 = KD-tree, 6 = LSH); \"eps\" is stored as float.",
                    " *",
                    " * Example (LSH, suitable for binary descriptors such as ORB):",
                    " *   FlannBasedMatcher(indexParams: [\"algorithm\": 6, \"table_number\": 6, \"key_size\": 12, \"multi_probe_level\": 1],",
                    " *                     searchParams: [\"checks\": 50])",
                    " *",
                    " * @param indexParams Index parameters. An empty dictionary yields a linear (brute-force) index.",
                    " * @param searchParams Search parameters. Unspecified keys keep cv::flann::SearchParams defaults.",
                    " */",
                    "- (instancetype)initWithIndexParams:(NSDictionary<NSString*, id>*)indexParams searchParams:(NSDictionary<NSString*, id>*)searchParams;",
                    "",
                    "/**",
                    " * Creates a FLANN-based descriptor matcher with custom index parameters and default search parameters.",
                    " */",
                    "- (instancetype)initWithIndexParams:(NSDictionary<NSString*, id>*)indexParams;",
                    "",
                    "/**",
                    " * Creates a FLANN-based descriptor matcher with a KD-tree index and default search parameters.",
                    " */",
                    "- (instancetype)init;",
                    ""
                ],
                "implementation" : [
                    "",
                    "// Private helper (not declared in the header). Mirrors pyopencv_to(PyObject*, cv::flann::IndexParams&)",
                    "// in modules/flann/misc/python/pyopencv_flann.hpp. A class method instead of a C function, because",
                    "// ManualFuncs code is emitted inside @implementation (-Wfunction-def-in-objc-container).",
                    "+ (void)fillFlannParams:(NSDictionary<NSString*, id>*)dict into:(cv::flann::IndexParams&)params {",
                    "    for (NSString* key in dict) {",
                    "        id value = dict[key];",
                    "        std::string name(key.UTF8String);",
                    "        if ([value isKindOfClass:[NSNumber class]]) {",
                    "            NSNumber* number = (NSNumber*)value;",
                    "            if (CFGetTypeID((__bridge CFTypeRef)number) == CFBooleanGetTypeID()) {",
                    "                params.setBool(name, number.boolValue);",
                    "            } else if (CFNumberIsFloatType((__bridge CFNumberRef)number)) {",
                    "                if (name == \"eps\") {",
                    "                    params.setFloat(name, number.floatValue);",
                    "                } else {",
                    "                    params.setDouble(name, number.doubleValue);",
                    "                }",
                    "            } else if (name == \"algorithm\") {",
                    "                params.setAlgorithm(number.intValue);",
                    "            } else {",
                    "                params.setInt(name, number.intValue);",
                    "            }",
                    "        } else if ([value isKindOfClass:[NSString class]]) {",
                    "            params.setString(name, std::string(((NSString*)value).UTF8String));",
                    "        } else {",
                    "            [NSException raise:NSInvalidArgumentException",
                    "                        format:@\"Failed to parse FLANN parameter '%@'. Supported types: Bool, Int, Double, String\", key];",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "//",
                    "// C++:   cv::FlannBasedMatcher::FlannBasedMatcher(Ptr_flann_IndexParams indexParams = makePtr<flann::KDTreeIndexParams>(), Ptr_flann_SearchParams searchParams = makePtr<flann::SearchParams>())",
                    "//",
                    "- (instancetype)initWithIndexParams:(NSDictionary<NSString*, id>*)indexParams searchParams:(NSDictionary<NSString*, id>*)searchParams {",
                    "    cv::Ptr<cv::flann::IndexParams> nativeIndexParams = cv::makePtr<cv::flann::IndexParams>();",
                    "    cv::Ptr<cv::flann::SearchParams> nativeSearchParams = cv::makePtr<cv::flann::SearchParams>();",
                    "    [FlannBasedMatcher fillFlannParams:indexParams into:*nativeIndexParams];",
                    "    [FlannBasedMatcher fillFlannParams:searchParams into:*nativeSearchParams];",
                    "    return [self initWithNativePtr:cv::makePtr<cv::FlannBasedMatcher>(nativeIndexParams, nativeSearchParams)];",
                    "}",
                    "",
                    "- (instancetype)initWithIndexParams:(NSDictionary<NSString*, id>*)indexParams {",
                    "    return [self initWithIndexParams:indexParams searchParams:@{}];",
                    "}",
                    "",
                    "- (instancetype)init {",
                    "    return [self initWithNativePtr:cv::makePtr<cv::FlannBasedMatcher>()];",
                    "}",
                    ""
                ]
            }
        }
    },
